# ~/.zshrc — interactive shell config. Minimal, no plugin manager.

# ---- history ----------------------------------------------------------------
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_SPACE HIST_REDUCE_BLANKS

# ---- completion -------------------------------------------------------------
autoload -Uz compinit && compinit -i
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

# ---- prompt (minimal, no external deps) -------------------------------------
autoload -Uz vcs_info
precmd() { vcs_info }
zstyle ':vcs_info:git:*' formats ' (%b)'
setopt PROMPT_SUBST
PROMPT='%F{cyan}%n@%m%f %F{yellow}%~%f%F{magenta}${vcs_info_msg_0_}%f %# '

# ---- key bindings -----------------------------------------------------------
bindkey -e
bindkey '^[[A' history-search-backward
bindkey '^[[B' history-search-forward

# ---- tools ------------------------------------------------------------------

# Build PATH first, BEFORE activating fnm/direnv/uv — they all live in
# ~/.local-or-similar dirs that zsh won't find unless we explicitly add them.
#   ~/.local/bin           — bws, zellij, mcp-grafana (non-root installs)
#   ~/.bun/bin             — bun installer's default
#   ~/.local/share/fnm     — fnm binary (we pass --install-dir to keep it isolated)
for _polysim_bin in "$HOME/.local/bin" "$HOME/.bun/bin" "$HOME/.local/share/fnm"; do
  case ":$PATH:" in
    *":$_polysim_bin:"*) ;;
    *) [ -d "$_polysim_bin" ] && PATH="$_polysim_bin:$PATH" ;;
  esac
done
unset _polysim_bin

# fnm (Node version manager) — activates the default node, prepending its
# bin dir (containing globally-npm-installed CLIs like `claude`) to PATH.
if command -v fnm >/dev/null 2>&1; then
  eval "$(fnm env --shell zsh)"
fi

# direnv
if command -v direnv >/dev/null 2>&1; then
  eval "$(direnv hook zsh)"
fi

# uv (Python)
[ -f "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"

# ---- polysim shell init (BWS_ACCESS_TOKEN, BWS_PROJECT_ID) ------------------
[ -r "$HOME/.config/polysim/shell-init.sh" ] && . "$HOME/.config/polysim/shell-init.sh"

# ---- aliases ----------------------------------------------------------------
alias g=git
alias ll='ls -lah'
alias gs='git status'
alias gd='git diff'
alias gl='git log --oneline --graph --decorate -20'
alias xo='xdg-open'
command -v fdfind >/dev/null 2>&1 && alias fd=fdfind

# ---- zellij polysimulator workflow ------------------------------------------
# zpoly       — attach existing polysimulator session, or start it with the layout
# zpoly_reset — kill + recreate polysimulator session from scratch
zpoly() {
  cd "$HOME/projects/polysimulator" || return
  zellij attach polysimulator -c options --default-layout polysimulator
}
zpoly_reset() {
  cd "$HOME/projects/polysimulator" || return
  zellij kill-session polysimulator 2>/dev/null || true
  zellij delete-session polysimulator 2>/dev/null || true
  zellij --new-session-with-layout polysimulator -s polysimulator
}

# ---- long-running agent sessions --------------------------------------------
# One dedicated, detachable zellij session per project, so a Claude agent keeps
# working while the laptop is shut or the network drops. Generic on purpose:
# moving a session to another machine should be one line here, not a new layout.
#
#   zagent <name> [dir]   attach, or create in ~/projects/<name> using
#                         the agent-session layout
#   zagent_reset <name>   kill and recreate from scratch (loses the agent's
#                         context; its MEMORY store survives, so this is safe)
#   zbiz                  polysimulator-business
#
# After creating a session, run /rc inside it once to enable Remote Control if
# you want it reachable from the phone - that is per-session and not scriptable.
zagent() {
  local name="${1:?usage: zagent <session-name> [dir]}"
  local dir="${2:-$HOME/projects/$name}"
  if [ ! -d "$dir" ]; then
    printf 'zagent: no such directory: %s\n' "$dir" >&2
    return 1
  fi
  cd "$dir" || return 1
  zellij attach "$name" -c options --default-layout agent-session
}
zagent_reset() {
  local name="${1:?usage: zagent_reset <session-name> [dir]}"
  zellij kill-session "$name" 2>/dev/null || true
  zellij delete-session "$name" 2>/dev/null || true
  zagent "$@"
}
zbiz() { zagent polysimulator-business "$@"; }

# ---- local overrides (gitignored) -------------------------------------------
[ -r "$HOME/.zshrc.local" ] && . "$HOME/.zshrc.local"
