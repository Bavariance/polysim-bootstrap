# ~/.bashrc — interactive shell config for bash. Mirror of zshrc.

# Skip if not interactive
case $- in *i*) ;; *) return ;; esac

# ---- bash-completion (programmable tab-complete for git, gh, docker, …) -----
# Debian auto-sources /etc/bash.bashrc which usually does this; Fedora doesn't.
# Sourcing explicitly here is harmless on both and guarantees completion works.
if ! shopt -oq posix; then
  if [ -r /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -r /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi

# ---- friendlier defaults (lesspipe, ls/grep colors) -------------------------
[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"

if [ -x /usr/bin/dircolors ]; then
  test -r "$HOME/.dircolors" \
    && eval "$(dircolors -b "$HOME/.dircolors")" \
    || eval "$(dircolors -b)"
  alias ls='ls --color=auto'
  alias grep='grep --color=auto'
  alias fgrep='fgrep --color=auto'
  alias egrep='egrep --color=auto'
fi

# ---- history ----------------------------------------------------------------
HISTFILE="$HOME/.bash_history"
HISTSIZE=50000
HISTFILESIZE=50000
HISTCONTROL=ignoredups:ignorespace
shopt -s histappend checkwinsize

# ---- prompt (minimal git-aware, no external deps) ---------------------------
_polysim_git_branch() {
  local b
  b="$(git symbolic-ref --short HEAD 2>/dev/null)" \
    || b="$(git rev-parse --short HEAD 2>/dev/null)" \
    || return
  printf ' (%s)' "$b"
}
PROMPT_COMMAND='PS1="\[\e[36m\]\u@\h\[\e[0m\] \[\e[33m\]\w\[\e[0m\]\[\e[35m\]$(_polysim_git_branch)\[\e[0m\] \$ "'

# ---- key bindings -----------------------------------------------------------
# Up/Down search history matching what's already typed
bind '"\e[A": history-search-backward' 2>/dev/null
bind '"\e[B": history-search-forward'  2>/dev/null

# ---- tools ------------------------------------------------------------------

# fnm (Node version manager)
if command -v fnm >/dev/null 2>&1; then
  eval "$(fnm env --shell bash)"
fi

# direnv
if command -v direnv >/dev/null 2>&1; then
  eval "$(direnv hook bash)"
fi

# uv (Python)
[ -f "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"

# ~/.local/bin and ~/.bun/bin on PATH (bws/zellij may live in the former
# for non-root installs; bun installs to the latter by default)
for _polysim_bin in "$HOME/.local/bin" "$HOME/.bun/bin"; do
  case ":$PATH:" in
    *":$_polysim_bin:"*) ;;
    *) [ -d "$_polysim_bin" ] && PATH="$_polysim_bin:$PATH" ;;
  esac
done
unset _polysim_bin

# ---- polysim shell init (BWS_ACCESS_TOKEN, BWS_PROJECT_ID) ------------------
[ -r "$HOME/.config/polysim/shell-init.sh" ] && . "$HOME/.config/polysim/shell-init.sh"

# ---- aliases ----------------------------------------------------------------
alias g=git
alias ll='ls -lah'
alias gs='git status'
alias gd='git diff'
alias gl='git log --oneline --graph --decorate -20'
alias xo='xdg-open'
command -v fdfind >/dev/null 2>&1 && alias fd=fdfind

# ---- zellij polysimulator workflow ------------------------------------------
# zpoly       — attach existing polysimulator session, or start it with the layout
# zpoly_reset — kill + recreate polysimulator session from scratch
zpoly() {
  cd "$HOME/projects/polysimulator" || return
  zellij attach polysimulator -c options --default-layout polysimulator
}
zpoly_reset() {
  cd "$HOME/projects/polysimulator" || return
  zellij kill-session polysimulator 2>/dev/null || true
  zellij delete-session polysimulator 2>/dev/null || true
  zellij --new-session-with-layout polysimulator -s polysimulator
}

# ---- local overrides (gitignored) -------------------------------------------
[ -r "$HOME/.bashrc.local" ] && . "$HOME/.bashrc.local"
