# --- secrets: never commit anything that could possibly hold one ------------
*.env
*.env.*
.env
.env.*
*.secret
*.secrets
*.pem
*.key
*.pfx
*.p12
*.crt
*.cer
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*
known_hosts
authorized_keys
.netrc
.git-credentials

# --- bws (Bitwarden Secrets Manager) state ----------------------------------
# These only ever live in ~/.config/polysim/, but block them in-repo too
# in case someone overrides the config dir to point inside this checkout.
bws-token
bws-project-id
configs/polysim/bws-token
configs/polysim/bws-project-id
configs/polysim/*.local.sh

# --- OS / editor cruft ------------------------------------------------------
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~

# --- local install / scratch ------------------------------------------------
*.log
bootstrap/*.local.sh
